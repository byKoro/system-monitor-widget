<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/process_item_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

    <!-- Ícone do App -->
    <ImageView
        android:id="@+id/iv_process_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:contentDescription="Ícone do processo"
        android:src="@android:drawable/sym_def_app_icon" />

    <!-- Nome e Pacote -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_process_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Nome do App"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_process_package"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="com.exemplo.app"
            android:textColor="@color/text_secondary"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Tempo / Status / Métrica -->
    <TextView
        android:id="@+id/tv_process_metric"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#2600E5FF"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:text="Ativo agora"
        android:textColor="@color/primary"
        android:textSize="10sp"
        android:textStyle="bold" />

</LinearLayout>
